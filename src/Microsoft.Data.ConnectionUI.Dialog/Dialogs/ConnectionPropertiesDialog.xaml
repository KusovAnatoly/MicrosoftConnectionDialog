<Window x:Class="Microsoft.Data.ConnectionUI.Dialog.ConnectionPropertiesDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Microsoft.Data.ConnectionUI.Dialog"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        d:ResizeMode="CanResize"
        Title="Connection Properties"
        MinHeight="450" Width="400">

    <Grid x:Name="RootGrid" RowDefinitions="Auto * Auto">

        <Grid ColumnDefinitions="* Auto"
              RowDefinitions="Auto Auto"
              Margin="16">

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Text="Data Source"
                       Margin="0,0,8,6" />
            
            <TextBox x:Name="DataSourceTextBox" 
                     Grid.Row="1" Grid.Column="0"
                     IsReadOnly="True"
                     Margin="0,0,8,0"/>

            <Button x:Name="ChangeButton"
                    Grid.Row="1" Grid.Column="1"
                    Content="Change"
                    Margin="8,0,0,0"
                    Click="ChangeButton_Click"/>

        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="Auto *"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">

            <Button x:Name="TestButton"
                    Grid.Column="0"
                    Content="Test"
                    MinWidth="80"
                    Margin="16"
                    Click="TestButton_Click" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16">

                <Button x:Name="OkButon"
                        Content="OK"
                        MinWidth="80"
                        Margin="8,0"
                        Click="OkButon_Click"/>

                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="80"
                        Margin="8,0"
                        Click="CancelButton_Click"/>
                
            </StackPanel>

        </Grid>

    </Grid>

</Window>
