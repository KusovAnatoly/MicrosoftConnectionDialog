<Window x:Class="Microsoft.Data.ConnectionUI.Dialog.DataConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Microsoft.Data.ConnectionUI.Dialog"
        xmlns:viewModels="clr-namespace:Microsoft.Data.ConnectionUI.Dialog.ViewModels"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Choose Data Source"
        Height="450" Width="800">

    <Grid RowDefinitions="* Auto">

        <Grid Grid.Row="0"
              ColumnDefinitions="* *" RowDefinitions="Auto * Auto Auto"
              Margin="16">


            <TextBlock Grid.Row="0" Grid.Column="0"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Text="Data source"
                       Margin="0,0,8,6" />

            <ListView Grid.Row="1" Grid.Column="0"
                      ItemsSource="{Binding DataSources}"
                      SelectedItem="{Binding SelectedDataSource}"
                      DisplayMemberPath="DisplayName"
                       Margin="0,6,8,6" />

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Text="Data provider"
                       Margin="0,6,8,6"/>

            <ComboBox Grid.Row="3" Grid.Column="0"
                      ItemsSource="{Binding SelectedDataSource.Providers}"
                      SelectedItem="{Binding SelectedDataProvider}"
                      DisplayMemberPath="DisplayName"
                      Margin="0,6,8,12" />

            <GroupBox Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
                  Header="Description"
                  Margin="8,0,0,12">

                <TextBlock Text="{Binding SelectedDataProvider.Description}"
                       TextWrapping="Wrap"/>

            </GroupBox>

        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="* *"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">

            <CheckBox Grid.Column="0"
                      HorizontalAlignment="Left"
                      Content="Always use this selection"
                      Margin="16"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16">

                <Button Content="About"
                        MinWidth="80" />
                
                <Button Content="OK"
                        MinWidth="80"
                        Margin="8,0"
                        Command="{Binding OpenConnectionPropertiesCommand}"/>
                
                <Button Content="Cancel"
                        MinWidth="80" />

            </StackPanel>

        </Grid>

    </Grid>

</Window>
