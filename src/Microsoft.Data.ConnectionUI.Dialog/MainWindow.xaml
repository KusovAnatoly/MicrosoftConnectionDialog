<Window x:Class="Microsoft.Data.ConnectionUI.Dialog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Microsoft.Data.ConnectionUI.Dialog"
        xmlns:viewModels="clr-namespace:Microsoft.Data.ConnectionUI.Dialog.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        mc:Ignorable="d"
        Title="Choose Data Source"
        Height="450" Width="800">

    <Grid RowDefinitions="* Auto Auto" ColumnDefinitions="* *"
          Margin="8">

        <Grid Grid.Row="0" Grid.Column="0"
              RowDefinitions="Auto * Auto Auto">

            <TextBlock Grid.Row="0"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Text="Data source" Margin="0,0,0,8"/>
            
            <ListView Grid.Row="1" />

            <TextBlock Grid.Row="2"
                       Style="{DynamicResource CaptionTextBlockStyle}"
                       Text="Data provider" Margin="0,8,0,8"/>
            
            <ComboBox Grid.Row="3" ItemsSource="{Binding DataSources}"
                      DisplayMemberPath="DisplayName"/>

        </Grid>

        <GroupBox Grid.Row="0" Grid.Column="1"
                  Header="Description"
                  Content="Description"/>



        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  HorizontalAlignment="Left"
                  Content="Always use this selection"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="About" Width="60" Margin="6,0" />
            <Button Content="OK" Width="60" Margin="6,0"/>
            <Button Content="Cancel" Width="60" Margin="6,0" />

        </StackPanel>

    </Grid>
    
</Window>
